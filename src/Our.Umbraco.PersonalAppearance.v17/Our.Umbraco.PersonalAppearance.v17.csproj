<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Our.Umbraco.PersonalAppearance</RootNamespace>
    <PackageId>Umbraco.Aura.v17</PackageId>
    <Version>0.1.1-umbraco17</Version>
    <Title>Umbraco Aura (Umbraco 17)</Title>
    <Description>Umbraco Aura for Umbraco 17 — profile preferences, contrast-safe theming, editor protection.</Description>
    <IsPackable>true</IsPackable>
    <StaticWebAssetBasePath>App_Plugins/Our.Umbraco.PersonalAppearance</StaticWebAssetBasePath>
    <DefineConstants>$(DefineConstants);UMBRACO_17</DefineConstants>
    <PackageTags>umbraco;umbraco-marketplace</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.4.2" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Our.Umbraco.PersonalAppearance.Core\Our.Umbraco.PersonalAppearance.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Our.Umbraco.PersonalAppearance.Shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
